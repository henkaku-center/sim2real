# Copy outside the repository to /etc/sesame-voice/relay.env (mode 600).
VOICE_DEVICE_TOKEN=replace-with-the-same-random-device-token
VOICE_SERVER_URL=https://YOUR-VM.YOUR-TAILNET.ts.net
VOICE_SERIAL_PORT=/dev/serial/by-id/YOUR-ROBOT
VOICE_INPUT=evdev
# One keypad, or comma-separated button and keyboard event-device paths:
VOICE_INPUT_DEVICE=/dev/input/by-id/YOUR-KEYPAD-event-kbd
VOICE_PTT_CODE=57
VOICE_AUDIO_DEVICE=plughw:CARD=Device,DEV=0
# Optional physical GPIO button (install gpio extra; add user to gpio group):
# VOICE_GPIO_CHIP=/dev/gpiochip0
# VOICE_GPIO_LINE=17
