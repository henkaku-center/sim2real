# Copy outside the repository to /etc/sesame-voice/server.env (mode 600).
VOICE_DEVICE_TOKEN=replace-with-a-random-shared-device-token
VOICE_PROVIDER=fake
# For real transcription/planning, set VOICE_PROVIDER=openai and supply:
# OPENAI_API_KEY=your-key-in-the-private-environment-file-only
VOICE_STT_MODEL=gpt-transcribe
VOICE_PLAN_MODEL=gpt-6.1-terra
