# Copy outside the repository to /etc/sesame-voice/server.env (mode 600).
VOICE_DEVICE_TOKEN=replace-with-a-random-shared-device-token
VOICE_PROVIDER=claude
# Test gateway: replace the URL with its actual deployment origin and use its
# access token. Direct Console API: use the URL below and an Anthropic API key.
VOICE_CLAUDE_BASE_URL=https://api.anthropic.com
VOICE_CLAUDE_TOKEN=replace-in-private-environment-file-only
VOICE_PLAN_MODEL=claude-haiku-4-5
VOICE_STT_URL=https://kotoleaf.wandering-sky-fcce.workers.dev
VOICE_STT_TOKEN=replace-in-private-environment-file-only
# Explicit offline mode: VOICE_PROVIDER=fake
