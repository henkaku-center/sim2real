+// Living face: ~8 fps idle, 4 fps while outputs or measurements are active
+// (each 100 kHz frame blocks the loop for roughly 90 ms).
+void livingFaceService() {
+  const bool busy = gate.active() || owner == BUTTON;
+  if (millis() - lastFace < (busy ? 250u : 125u)) return;
+  lastFace = millis();
+  display.clearDisplay();
+  alive.render(display, lastFace);
+  if (busy) {
+    display.fillRect(0, 0, 128, 9, SSD1306_BLACK);
+    display.setCursor(0,0); display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
+    if (owner == BUTTON) display.printf("Centre %lus", (unsigned long)((30000 - (millis() - buttonStart))/1000));
+    else display.print("ACTIVE / BOOT: OFF");
+  }
+  uint32_t hash = 2166136261u;
+  const uint8_t* buffer = display.getBuffer();
+  for (int i = 0; i < 128 * 64 / 8; ++i) hash = (hash ^ buffer[i]) * 16777619u;
+  if (hash != lastHash) { display.display(); lastHash = hash; }
+}
