diff --git a/firmware/sesame-s3/pet_sensors.h b/firmware/sesame-s3/pet_sensors.h
new file mode 100644
index 0000000..b199abc
--- /dev/null
+++ b/firmware/sesame-s3/pet_sensors.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+// Pet sensors, face reactions only (no servo motion):
+//  - touch pad (metal disc / copper tape inside the dome) wired to GPIO6, the
+//    ESP32-S3's built-in capacitive touch input: tap, triple tap, stroke;
+//  - M5Stack Unit ToF (VL53L0X, I2C 0x29, shares SDA2/SCL3 with hub and OLED)
+//    looking down at the floor: lifted / put down.
+// Both are optional: a missing pad or sensor just never reports events.
+#pragma once
+#include <Arduino.h>
+#include <VL53L0X.h>
+
+namespace pet {
+constexpr int TOUCH_GPIO = 6;
+enum class Event : uint8_t { None, Tap, TripleTap, Stroke, StrokeEnd, Lifted, PutDown };
+
+// Touch: S3 touch values rise when a finger is near. Track an untouched
+// baseline and call it touched above baseline * (1 + sensitivity).
+struct Touch {
+  uint32_t raw = 0, base = 0;
+  float sensitivity = 0.08f;            // 8 %: metal disc in the dome reads +20..136 % when touched, < 1 % noise
+  bool touched = false, stroking = false;
+  uint32_t since = 0, lastTap = 0, last = 0;
+  uint8_t taps = 0;
+  Event poll(uint32_t now) {
+    if (now - last < 40) return Event::None;
+    last = now;
+    raw = touchRead(TOUCH_GPIO);
+    if (!base) { base = raw; return Event::None; }
+    const bool on = raw > base * (1 + sensitivity);
+    if (!on) base = (base * 31 + raw) / 32;   // follow slow drift only while untouched
+    if (on && !touched) { touched = true; since = now; return Event::None; }
+    if (on && !stroking && now - since > 1200) { stroking = true; return Event::Stroke; }
+    if (!on && touched) {
+      touched = false;
+      if (stroking) { stroking = false; return Event::StrokeEnd; }
+      if (now - since < 600) {          // a tap; three within 2 s is a triple tap
+        taps = now - lastTap < 2000 ? taps + 1 : 1; lastTap = now;
+        if (taps >= 3) { taps = 0; return Event::TripleTap; }
+        return Event::Tap;
+      }
+    }
+    return Event::None;
+  }
+};
+
+// Pick-me-up: learn the floor distance while resting; much farther (or out of
+// range) for 300 ms = lifted, back near the floor for 500 ms = put down.
+struct Lift {
+  VL53L0X tof;
+  bool ok = false, lifted = false;
+  uint16_t mm = 0; float floor = 0;
+  uint32_t changed = 0, last = 0, lastGood = 0, lastInit = 0;
+  uint16_t restarts = 0;
+  bool begin() {
+    tof.setTimeout(30);
+    lastInit = lastGood = millis();
+    ok = tof.init();
+    if (ok) tof.startContinuous(50);
+    return ok;
+  }
+  Event poll(uint32_t now) {
+    if (now - last < 25) return Event::None;   // light I2C load on the shared bus
+    last = now;
+    if (!ok) {                                  // absent or failed init: keep retrying every 3 s
+      if (now - lastInit > 3000) { ++restarts; begin(); }
+      return Event::None;
+    }
+    // A supply blip (or a loose plug) resets the sensor: reads then fail
+    // (0xFF / 0xFFFF) or stop. That is not "lifted": re-initialise instead.
+    const uint8_t status = tof.readReg(VL53L0X::RESULT_INTERRUPT_STATUS);
+    if (status == 0xFF || !(status & 0x07)) {
+      if (now - lastGood > 3000 && now - lastInit > 3000) { ++restarts; begin(); }
+      return Event::None;
+    }
+    mm = tof.readReg16Bit(VL53L0X::RESULT_RANGE_STATUS + 10);
+    tof.writeReg(VL53L0X::SYSTEM_INTERRUPT_CLEAR, 0x01);
+    if (mm == 0xFFFF) return Event::None;   // failed read, not a distance
+    lastGood = now;
+    const bool valid = mm > 20 && mm < 2000;  // 8190 = nothing in range; < 20 = too close to trust
+    // Floor: learned only below 15 cm (rest/stand heights), so a slow lift
+    // cannot drag it up; lifted = 10 cm above it (or nothing in range).
+    if (!floor && valid && mm < 150) floor = mm;
+    const bool far = mm >= 2000 || (floor && valid && mm > floor + 100);
+    if (!lifted && !far && valid && mm < 150) floor = floor * 0.8f + mm * 0.2f;
+    if (far == lifted) { changed = now; return Event::None; }
+    if (now - changed < (far ? 300u : 500u)) return Event::None;
+    lifted = far; changed = now;
+    return lifted ? Event::Lifted : Event::PutDown;
+  }
+};
+} // namespace pet
diff --git a/firmware/sesame-s3/usb_mic.h b/firmware/sesame-s3/usb_mic.h
new file mode 100644
index 0000000..51e0d76
--- /dev/null
+++ b/firmware/sesame-s3/usb_mic.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0
+// Akizuki AE-MICAMP (OPA344 x100, output centred at VCC/2) on GPIO5 / ADC1_CH4,
+// powered from 3V3. While a USB host holds a `mic on` lease (renewed every
+// second or so), a core-0 task streams 16 kHz 16-bit mono to it over the USB
+// serial port in frames 0xA5 0x5A + 256 little-endian samples, interleaved with
+// normal text replies. On battery the laptop joins the robot's Wi-Fi instead:
+// GET /mic holds a UDP lease and the same frames go to it on port 5005.
+// The laptop (body/mic-test/listen.py) recognises speech.
+#pragma once
+#include <Arduino.h>
+#include <WiFiUdp.h>
+#include <esp_adc/adc_continuous.h>
+
+namespace usb_mic {
+constexpr int GPIO = 5;
+constexpr uint32_t RATE = 16000, LEASE_MS = 3000;
+constexpr size_t SAMPLES = 256;
+adc_continuous_handle_t adc = nullptr;
+constexpr uint16_t UDP_PORT = 5005;
+volatile uint32_t leaseUntil = 0, udpUntil = 0, udpIp = 0;
+volatile uint16_t level = 0;            // recent peak |sample|, for `mic`
+
+void lease(uint32_t now) { leaseUntil = now + LEASE_MS; }
+void stop() { leaseUntil = 0; }
+bool streaming() { return int32_t(leaseUntil - millis()) > 0; }
+void udpLease(uint32_t ip, uint32_t now) { udpIp = ip; udpUntil = now + LEASE_MS; }
+bool udpStreaming() { return udpIp && int32_t(udpUntil - millis()) > 0; }
+
+void task(void*) {
+  static uint8_t raw[SAMPLES * SOC_ADC_DIGI_RESULT_BYTES];
+  static uint8_t frame[2 + SAMPLES * 2] = {0xA5, 0x5A};
+  float dc = 2048; uint16_t peak = 0; uint32_t peakAt = 0;
+  WiFiUDP udp;
+  for (;;) {
+    uint32_t got = 0;
+    if (adc_continuous_read(adc, raw, sizeof(raw), &got, 100) != ESP_OK) continue;
+    size_t n = 0;
+    for (uint32_t i = 0; i + SOC_ADC_DIGI_RESULT_BYTES <= got && n < SAMPLES; i += SOC_ADC_DIGI_RESULT_BYTES) {
+      const float v = reinterpret_cast<const adc_digi_output_data_t*>(raw + i)->type2.data;
+      dc += (v - dc) * (1.0f / 2048);   // remove the VCC/2 bias
+      const int16_t s = int16_t(constrain((v - dc) * 16, -32767.0f, 32767.0f));
+      frame[2 + 2 * n] = s & 0xFF; frame[3 + 2 * n] = uint16_t(s) >> 8; ++n;
+      if (uint16_t(abs(s)) > peak) peak = abs(s);
+    }
+    if (millis() - peakAt > 250) { level = peak; peak = 0; peakAt = millis(); }
+    if (n == SAMPLES && streaming() && Serial && Serial.availableForWrite() >= int(sizeof(frame)))
+      Serial.write(frame, sizeof(frame));
+    if (n == SAMPLES && udpStreaming()) {
+      udp.beginPacket(IPAddress(udpIp), UDP_PORT); udp.write(frame, sizeof(frame)); udp.endPacket();
+    }
+  }
+}
+
+bool begin() {
+  adc_continuous_handle_cfg_t handle = {};
+  handle.max_store_buf_size = 8 * SAMPLES * SOC_ADC_DIGI_RESULT_BYTES;
+  handle.conv_frame_size = SAMPLES * SOC_ADC_DIGI_RESULT_BYTES;
+  if (adc_continuous_new_handle(&handle, &adc) != ESP_OK) return false;
+  adc_digi_pattern_config_t pattern = {};
+  pattern.atten = ADC_ATTEN_DB_12; pattern.channel = ADC_CHANNEL_4;
+  pattern.unit = ADC_UNIT_1; pattern.bit_width = SOC_ADC_DIGI_MAX_BITWIDTH;
+  adc_continuous_config_t config = {};
+  config.pattern_num = 1; config.adc_pattern = &pattern; config.sample_freq_hz = RATE;
+  config.conv_mode = ADC_CONV_SINGLE_UNIT_1; config.format = ADC_DIGI_OUTPUT_FORMAT_TYPE2;
+  if (adc_continuous_config(adc, &config) != ESP_OK || adc_continuous_start(adc) != ESP_OK) return false;
+  return xTaskCreatePinnedToCore(task, "mic", 4096, nullptr, 2, nullptr, 0) == pdPASS;
+}
+} // namespace usb_mic
