new file mode 100644
index 0000000..60bb9af
--- /dev/null
+++ b/firmware/sesame-s3/living_face.h
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: Apache-2.0
+// Procedural "living" OLED face: natural blinks, glances, smoothly blended
+// moods and a talking mouth. Drawn with GFX primitives, not bitmaps, so every
+// parameter can ease between states instead of jumping frame to frame.
+#pragma once
+#include <Arduino.h>
+#include <Adafruit_GFX.h>
+#include <cmath>
+#include <cstring>
+
+namespace sesame {
+
+enum class Mood : uint8_t { Neutral, Happy, Sad, Angry, Surprised, Sleepy, Love, Confused, Count };
+constexpr const char* MOOD_NAMES[] = {"neutral", "happy", "sad", "angry", "surprised", "sleepy", "love", "confused"};
+
+// Every field eases independently, so mood changes morph rather than cut.
+struct FaceShape {
+  float w, h, r;          // eye size and corner radius (px)
+  float lidTop;           // fraction of eye hidden by a flat upper lid
+  float slant;            // +inner lid down (angry), -outer lid down (sad)
+  float lidBottom;        // fraction pushed up from below (happy squint)
+  float leftScale, rightScale;
+  float mouthCurve;       // +smile, -frown
+  float mouthWidth;       // half-width (px)
+  float mouthO;           // 0..1 surprised "o"
+  float heart;            // 0..1, >0.5 draws hearts instead of eyes
+};
+
+constexpr FaceShape SHAPES[] = {
+  /* neutral   */ {30, 30,  8, 0.00f,  0.00f, 0.00f, 1.00f, 1.00f,  0.15f, 9, 0, 0},
+  /* happy     */ {32, 30,  9, 0.00f,  0.00f, 0.50f, 1.00f, 1.00f,  1.00f, 13, 0, 0},
+  /* sad       */ {28, 26,  8, 0.12f, -0.40f, 0.00f, 1.00f, 1.00f, -0.80f, 9, 0, 0},
+  /* angry     */ {30, 26,  6, 0.10f,  0.50f, 0.00f, 1.00f, 1.00f, -0.35f, 11, 0, 0},
+  /* surprised */ {34, 36, 13, 0.00f,  0.00f, 0.00f, 1.00f, 1.00f,  0.00f, 5, 1, 0},
+  /* sleepy    */ {30, 30,  8, 0.50f, -0.10f, 0.00f, 1.00f, 1.00f,  0.00f, 7, 0, 0},
+  /* love      */ {30, 30,  8, 0.00f,  0.00f, 0.00f, 1.00f, 1.00f,  1.00f, 11, 0, 1},
+  /* confused  */ {30, 30,  8, 0.05f,  0.00f, 0.00f, 1.00f, 0.65f, -0.25f, 8, 0, 0},
+};
+
+inline float frand(float lo, float hi) { return lo + (hi - lo) * (random(0, 10001) / 10000.0f); }
+inline bool chance(float p) { return frand(0, 1) < p; }
+
+class LivingFace {
+public:
+  bool setMood(const char* name) {
+    if (!strcmp(name, "auto")) { autoMood = true; nextAuto = now + 4000; return true; }
+    for (int m = 0; m < int(Mood::Count); ++m) if (!strcmp(name, MOOD_NAMES[m])) {
+      autoMood = false; target = Mood(m); return true;
+    }
+    return false;
+  }
+  const char* moodName() const { return autoMood ? "auto" : MOOD_NAMES[int(target)]; }
+  // Hold a gaze for a few seconds, then resume glancing.
+  void look(float x, float y) {
+    gazeTarget[0] = constrain(x, -1.f, 1.f); gazeTarget[1] = constrain(y, -1.f, 1.f);
+    nextGlance = now + 3000;
+  }
+  void talk(uint32_t ms) { talkUntil = max(talkUntil, now + ms); }
+  // Something just happened: glance at the user, sometimes blink.
+  void attend() {
+    gazeTarget[0] = frand(-.15f, .15f); gazeTarget[1] = frand(0, .2f);
+    nextGlance = now + uint32_t(frand(1500, 3000));
+    if (chance(.3f)) blinkStart = now;
+  }
+  // Show a word instead of the eyes (eyes close, the word pops up, eyes reopen).
+  void showText(const char* t, uint32_t ms) {
+    strncpy(text, t, sizeof(text) - 1); text[sizeof(text) - 1] = 0;
+    textStart = now ? now : 1; textUntil = textStart + ms;
+  }
+  // Picked up: a big panic face until put down (see drawPanic).
+  void panic(bool on) { panicStart = on ? (now ? now : 1) : 0; }
+  bool panicking() const { return panicStart; }
+  // A pet sensor event: show a mood for a while and look at the user.
+  void react(Mood m, uint32_t ms) { burst(m, ms); attend(); }
+  // Map a stock motion to a mood while it runs.
+  void motionMood(const char* motion) {
+    static const char* const happy[] = {"dance", "wave", "cute", "bow", "point", "pushup", "crab", "swim"};
+    Mood m = Mood::Neutral;
+    for (auto n : happy) if (strstr(motion, n)) m = Mood::Happy;
+    if (strstr(motion, "freaky") || strstr(motion, "shake")) m = Mood::Surprised;
+    if (strstr(motion, "dead")) m = Mood::Sleepy;
+    if (strstr(motion, "shrug")) m = Mood::Confused;
+    burst(m, 4000);
+  }
+
+  // Advance time and draw into the GFX buffer (caller clears and flushes).
+  void render(Adafruit_GFX& g, uint32_t ms) {
+    const float dt = last ? min(200.f, float(ms - last)) : 33.f;
+    last = now = ms;
+    behave();
+    if (panicStart) { drawPanic(g); return; }
+    if (textUntil && now < textUntil) { drawText(g); return; }
+    if (textUntil) { textUntil = 0; blinkStart = now; }   // eyes come back with a blink
+    const Mood m = autoMood && now < burstUntil ? burstMood : autoMood ? autoBase : target;
+    ease(SHAPES[int(m)], 1 - expf(-dt / 110.f));
+    const float k = 1 - expf(-dt / (m == Mood::Sleepy ? 140.f : 45.f));  // saccades are fast
+    gaze[0] += (gazeTarget[0] - gaze[0]) * k;
+    gaze[1] += (gazeTarget[1] - gaze[1]) * k;
+
+    const float breath = sinf(now * (2 * PI / 4200.f));
+    const float open = blinkOpenness(m == Mood::Sleepy ? 2.2f : 1.f);
+    const float gx = gaze[0] * 16, gy = gaze[1] * 9 + breath * .8f;
+    const float cy = 27 + gy;
+    for (int side = -1; side <= 1; side += 2) {
+      const float cx = 64 + side * 25 + gx;
+      // Perspective: the eye nearer the gaze direction looks a little larger.
+      const float persp = 1 + .08f * gaze[0] * side;
+      const float scale = (side < 0 ? s.leftScale : s.rightScale) * persp;
+      if (s.heart > .5f) drawHeart(g, cx, cy, 13 * (1 + .07f * sinf(now * .012f)) * max(open, .3f));
+      else drawEye(g, cx, cy, side, scale, open, breath);
+    }
+    drawMouth(g, 64 + gx * .35f, 55 + gy * .5f);
+  }
+
+private:
+  FaceShape s = SHAPES[0];
+  Mood target = Mood::Neutral, autoBase = Mood::Neutral, burstMood = Mood::Neutral;
+  bool autoMood = true;
+  uint32_t now = 0, last = 0, nextAuto = 6000, burstUntil = 0;
+  uint32_t blinkStart = 0, nextBlink = 2500, secondBlink = 0;
+  uint32_t nextGlance = 1500, talkUntil = 0, nextSyllable = 0;
+  float gaze[2] = {0, 0}, gazeTarget[2] = {0, 0};
+  float mouthOpen = 0, mouthTarget = 0;
+  uint32_t panicStart = 0, textStart = 0, textUntil = 0;
+  char text[16] = "";
+
+  // The word bounces in, with a small sparkle each side and a smiling mouth.
+  void drawText(Adafruit_GFX& g) {
+    const float t = now - textStart;
+    const int len = strlen(text), size = len <= 6 ? 3 : len <= 10 ? 2 : 1;
+    const int w = len * 6 * size, h = 8 * size;
+    const int bounce = lroundf(-10 * expf(-t / 180) * cosf(t / 45));
+    g.setTextSize(size); g.setTextColor(SSD1306_WHITE); g.setTextWrap(false);
+    g.setCursor(64 - w / 2, 22 - h / 2 + bounce); g.print(text);
+    for (int side = -1; side <= 1; side += 2) {   // twinkling sparkles
+      const int x = 64 + side * (w / 2 + 8), y = 14 + bounce / 2, r = 2 + int(now / 120) % 3;
+      g.drawFastHLine(x - r, y, 2 * r + 1, SSD1306_WHITE); g.drawFastVLine(x, y - r, 2 * r + 1, SSD1306_WHITE);
+    }
+    for (int dx = -10; dx <= 10; ++dx) {          // smile
+      const float u = dx / 10.f; const int dy = lroundf(4 * (1 - u * u));
+      g.drawPixel(64 + dx, 50 + dy, SSD1306_WHITE); g.drawPixel(64 + dx, 51 + dy, SSD1306_WHITE);
+    }
+  }
+
+  // Panic: shaking head, shocked wide eyes (first 1.2 s), then spinning stars
+  // with "dying" X eyes flashing every 3 s, a screaming zig-zag mouth and sweat
+  // drops. It grows stronger for the first 3 s of being held.
+  void drawPanic(Adafruit_GFX& g) {
+    const float t = (now - panicStart) / 1000.f, level = min(1.f, .4f + t / 3);
+    const int sx = lroundf(sinf(now * .09f) * 3 * level), sy = lroundf(cosf(now * .13f) * 1.5f * level);
+    for (int side = -1; side <= 1; side += 2) {
+      const int cx = 64 + side * 26 + sx, cy = 25 + sy;
+      if (t < 1.2f) {                   // shock: huge round eyes, tiny jittering pupils
+        g.fillCircle(cx, cy, 14, SSD1306_WHITE);
+        g.fillCircle(cx + lroundf(frand(-3, 3)), cy + lroundf(frand(-3, 3)), 3, SSD1306_BLACK);
+      } else if (fmodf(t, 3.f) > 2.4f) { // dying: X eyes
+        for (int d = -1; d <= 1; ++d) {
+          g.drawLine(cx - 10, cy - 10 + d, cx + 10, cy + 10 + d, SSD1306_WHITE);
+          g.drawLine(cx - 10, cy + 10 + d, cx + 10, cy - 10 + d, SSD1306_WHITE);
+        }
+      } else drawStar(g, cx, cy, 14 + 2 * sinf(now * .02f), now * .006f * side);
+    }
+    // Screaming mouth: open oval whose height wobbles, with a zig-zag of teeth.
+    const int mx = 64 + sx, my = 53 + sy, w = 30, h = lroundf(10 + 3 * level + 2 * sinf(now * .05f));
+    g.fillRoundRect(mx - w / 2, my - h / 2, w, h, h / 2, SSD1306_WHITE);
+    for (int x = -w / 2 + 3; x < w / 2 - 3; x += 4) {
+      g.drawLine(mx + x, my - 1, mx + x + 2, my + 2, SSD1306_BLACK);
+      g.drawLine(mx + x + 2, my + 2, mx + x + 4, my - 1, SSD1306_BLACK);
+    }
+    // Sweat drops sliding down beside the eyes.
+    for (int side = -1; side <= 1; side += 2) {
+      const int dx = 64 + side * 50 + sx, dy = 6 + int(now / 18 + (side > 0 ? 20 : 0)) % 40;
+      g.fillCircle(dx, dy + 3, 3, SSD1306_WHITE);
+      g.fillTriangle(dx - 3, dy + 2, dx + 3, dy + 2, dx, dy - 4, SSD1306_WHITE);
+    }
+  }
+  void drawStar(Adafruit_GFX& g, int cx, int cy, float r, float spin) {
+    float px[10], py[10];
+    for (int i = 0; i < 10; ++i) {
+      const float a = spin + i * PI / 5, rr = i % 2 ? r * .45f : r;
+      px[i] = cx + rr * sinf(a); py[i] = cy - rr * cosf(a);
+    }
+    for (int i = 0; i < 10; ++i) {
+      const int j = (i + 1) % 10;
+      g.fillTriangle(cx, cy, lroundf(px[i]), lroundf(py[i]), lroundf(px[j]), lroundf(py[j]), SSD1306_WHITE);
+    }
+  }
+
+  void burst(Mood m, uint32_t ms) { burstMood = m; burstUntil = now + ms; if (!autoMood) target = m; }
+
+  void ease(const FaceShape& t, float k) {
+    float* a = &s.w; const float* b = &t.w;
+    for (size_t i = 0; i < sizeof(FaceShape) / sizeof(float); ++i) a[i] += (b[i] - a[i]) * k;
+  }
+
+  void behave() {
+    const bool sleepy = !autoMood && target == Mood::Sleepy;
+    // Blinks: random 2-6 s apart, sometimes a double blink.
+    if (now >= nextBlink) {
+      blinkStart = now;
+      nextBlink = now + uint32_t(sleepy ? frand(3000, 7000) : frand(2000, 6000));
+      if (chance(.2f)) secondBlink = now + 260;
+    }
+    if (secondBlink && now >= secondBlink) { blinkStart = now; secondBlink = 0; }
+    // Glances: hold a point, then jump; often return to the middle.
+    if (now >= nextGlance) {
+      const float ox = gazeTarget[0], oy = gazeTarget[1];
+      if (chance(.35f)) { gazeTarget[0] = frand(-.08f, .08f); gazeTarget[1] = frand(-.05f, .05f); }
+      else { gazeTarget[0] = frand(-1, 1); gazeTarget[1] = frand(-.7f, .7f); }
+      if (sleepy) gazeTarget[1] = frand(.3f, .8f);
+      // People tend to blink with a big gaze shift.
+      if (fabsf(gazeTarget[0] - ox) + fabsf(gazeTarget[1] - oy) > .9f && chance(.35f)) blinkStart = now;
+      nextGlance = now + uint32_t(sleepy ? frand(3000, 6000) : frand(1200, 4000));
+    }
+    // Auto mood: mostly calm, with short flashes of feeling.
+    if (autoMood && now >= nextAuto) {
+      const float p = frand(0, 1);
+      if (p < .40f) burst(Mood::Happy, uint32_t(frand(2500, 5000)));
+      else if (p < .55f) burst(Mood::Confused, 1800);
+      else if (p < .65f) burst(Mood::Surprised, 900);
+      nextAuto = now + uint32_t(frand(7000, 16000));
+    }
+    // Talking: new syllable every 80-170 ms.
+    if (now < talkUntil) {
+      if (now >= nextSyllable) {
+        mouthTarget = chance(.15f) ? .1f : frand(.35f, 1);
+        nextSyllable = now + uint32_t(frand(80, 170));
+      }
+    } else mouthTarget = 0;
+    mouthOpen += (mouthTarget - mouthOpen) * .45f;
+  }
+
+  float blinkOpenness(float slow) const {
+    const float t = (now - blinkStart) / slow;
+    if (!blinkStart || t >= 230) return 1;
+    if (t < 70) return 1 - t / 70;
+    if (t < 100) return 0;
+    return (t - 100) / 130;
+  }
+
+  void drawEye(Adafruit_GFX& g, float cx, float cy, int side, float scale, float open, float breath) {
+    const int w = lroundf(s.w), h = max(2L, lroundf(s.h * scale * open + breath * .5f));
+    const int x0 = lroundf(cx - w / 2.f), y0 = lroundf(cy - h / 2.f);
+    g.fillRoundRect(x0, y0, w, h, min(int(lroundf(s.r)), min(w, h) / 2), SSD1306_WHITE);
+    if (h <= 3) return;
+    // Upper lid: a quad whose inner/outer heights give anger or sadness.
+    const float base = s.lidTop * h, tilt = s.slant * h * .5f;
+    const float inner = base + max(0.f, tilt), outer = base + max(0.f, -tilt);
+    const float leftDrop = side < 0 ? outer : inner, rightDrop = side < 0 ? inner : outer;
+    if (leftDrop > .5f || rightDrop > .5f) {
+      const int x1 = x0 + w, top = y0 - 1;
+      const int yl = y0 + lroundf(leftDrop), yr = y0 + lroundf(rightDrop);
+      g.fillTriangle(x0 - 1, top, x1, top, x1, yr, SSD1306_BLACK);
+      g.fillTriangle(x0 - 1, top, x1, yr, x0 - 1, yl, SSD1306_BLACK);
+    }
+    // Lower lid: a large circle rising from below leaves a happy crescent.
+    if (s.lidBottom > .02f) {
+      const float R = w * .85f;
+      g.fillCircle(lroundf(cx), lroundf(y0 + h + R - s.lidBottom * h), lroundf(R), SSD1306_BLACK);
+    }
+    // Catchlight makes the eye read as wet and alive.
+    if (open > .7f && s.lidBottom < .2f && s.lidTop < .2f && h > 16)
+      g.fillCircle(x0 + w / 4 + 1, y0 + h / 4 + 1, 2, SSD1306_BLACK);
+  }
+
+  void drawHeart(Adafruit_GFX& g, float cx, float cy, float size) {
+    const int r = max(2, int(lroundf(size / 2))), x = lroundf(cx), y = lroundf(cy - size / 4);
+    g.fillCircle(x - r + 1, y, r, SSD1306_WHITE);
+    g.fillCircle(x + r - 1, y, r, SSD1306_WHITE);
+    g.fillTriangle(x - 2 * r + 1, y + 1, x + 2 * r - 1, y + 1, x, lroundf(cy + size), SSD1306_WHITE);
+  }
+
+  void drawMouth(Adafruit_GFX& g, float mx, float my) {
+    const int x = lroundf(mx), y = lroundf(my);
+    if (mouthOpen > .08f) {           // talking: an opening and closing oval
+      const int w = lroundf(8 + 6 * mouthOpen), h = lroundf(2 + 7 * mouthOpen);
+      g.fillRoundRect(x - w / 2, y - h / 2, w, h, min(w, h) / 2, SSD1306_WHITE);
+      return;
+    }
+    if (s.mouthO > .5f) {             // surprised "o"
+      g.drawCircle(x, y, 4, SSD1306_WHITE); g.drawCircle(x, y, 3, SSD1306_WHITE);
+      return;
+    }
+    const int half = lroundf(s.mouthWidth);
+    int prev = 0;
+    for (int dx = -half; dx <= half; ++dx) {
+      const float u = float(dx) / half;
+      const int dy = lroundf(s.mouthCurve * 3.5f * (1 - u * u));
+      if (dx > -half) g.drawLine(x + dx - 1, y + prev, x + dx, y + dy, SSD1306_WHITE);
+      g.drawPixel(x + dx, y + dy + 1, SSD1306_WHITE);  // 2 px thick
+      prev = dy;
+    }
+  }
+};
+
+} // namespace sesame
