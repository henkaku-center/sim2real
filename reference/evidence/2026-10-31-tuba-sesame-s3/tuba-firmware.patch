+// Auto demo (battery only): ~5 s after power-on, arm and loop
+// rest -> stand -> rest -> stand -> wave -> dance -> walk (10 cycles = 20
+// steps) with 5 s pauses.
+// Never runs while a USB host is connected; needs saved + all-verified
+// calibration (arm run); BOOT, `off`, a fault or the watchdog end it until
+// the next power-on (or `demo on`).
+int poseJoint = 0;  // demo pose changes: next joint to move
+const char* const DEMO_SEQUENCE[] = {"rest", "stand", "rest", "stand", "wave", "dance", "walk"};
+bool startMotion(const char* name) {
+  for (const auto& m : MOTIONS) if (!strcmp(name, m.name)) {
+    cancelQueue(); motion = &m; motionIndex = 0; poseJoint = 0;
+    if (living) alive.motionMood(name);
+    return true;
+  }
+  return false;
+}
+void demoService() {
+  // A USB cable to a host (even with no serial port open) means bench, not battery.
+  if (!demoEnabled || HWCDC::isPlugged()) return;
+  const uint32_t now = millis();
+  if (demoRunning && (owner != DEMO || !gate.active())) {
+    demoEnabled = demoRunning = false; Serial.println("DEMO stopped"); return;
+  }
+  if (!demoRunning) {
+    if (now < 5000 || !ready || fault || !saved || gate.active()) return;
+    if (!gate.arm(Mode::Run, -1, now)) { demoEnabled = false; return; }
+    owner = DEMO; demoRunning = true; demoStep = 0; demoNext = now; cancelQueue();
+    logEvent("demo armed"); gate.heartbeat(millis());
+  }
+  gate.heartbeat(now);
+  if (motion) { demoNext = now + 5000; return; }
+  if (now < demoNext) return;
+  startMotion(DEMO_SEQUENCE[demoStep]);
+  logEvent(DEMO_SEQUENCE[demoStep]);
+  gate.heartbeat(millis());  // an NVS write can stall the loop
+  demoStep = (demoStep + 1) % (sizeof(DEMO_SEQUENCE) / sizeof(DEMO_SEQUENCE[0]));
+}
