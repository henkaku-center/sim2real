+// A supply dip (e.g. a Wi-Fi TX burst) can reset the OLED controller, leaving
+// it blank while the firmware keeps drawing. Every 2 s re-assert the
+// non-blanking setup commands (no display-off, so no flicker) and resend.
+void displayKeepAlive() {
+  static uint32_t lastCheck = 0;
+  if (millis() - lastCheck < 2000) return;
+  lastCheck = millis();
+  Wire.beginTransmission(OLED_ADDRESS);
+  if (Wire.endTransmission()) { screen = false; return; }
+  if (!screen) { screen = display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS, false, false); lastHash = 0; return; }
+  static const uint8_t setup[] = {
+    0xD5, 0x80, 0xA8, 63, 0xD3, 0x00, 0x40, 0x8D, 0x14, 0x20, 0x00, 0xA1, 0xC8,
+    0xDA, 0x12, 0x81, 0xCF, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0x2E, 0xAF};
+  for (uint8_t c : setup) display.ssd1306_command(c);
+  lastHash = 0;
