+// Auto demo (battery only): ~5 s after power-on, arm and loop
+// rest -> stand -> rest -> stand -> wave -> dance -> walk (10 cycles = 20
+// steps) with 5 s pauses.
+// Never runs while a USB host is connected; needs saved + all-verified
+// calibration (arm run); BOOT, `off`, a fault or the watchdog end it until
+// the next power-on (or `demo on`).
+int poseJoint = 0;          // demo pose: next joint to start
+uint32_t poseNext = 0;      // demo pose: when that joint may start
+const char* const DEMO_SEQUENCE[] = {"rest", "stand", "rest", "stand", "wave", "dance", "walk"};
+bool startMotion(const char* name) {
+  for (const auto& m : MOTIONS) if (!strcmp(name, m.name)) {
+    cancelQueue(); motion = &m; motionIndex = 0; poseJoint = 0; poseNext = 0;
+    if (living) alive.motionMood(name);
+    return true;
+  }
+  return false;
+}
+// Voice: the laptop (body/mic-test/listen.py --wifi) sends /voice?w=WORD.
+// Words: sit, stand, hello, wave, dance, walk, rest, stop. The first word arms
+// Run (saved, verified calibration) and takes over from the battery demo;
+// motions are finite and keep their own heartbeat. "stop", BOOT, a fault or
+// 2 min without a word turn outputs off. With a USB host plugged in the face
+// shows the word but the legs do not move (USB cannot power the servos).
+String voiceCommand(const char* word) {
+  struct Word { const char* word; const char* motion; const char* face; };
+  static const Word WORDS[] = {{"sit", "rest", "Sit!"}, {"rest", "rest", "Rest"}, {"stand", "stand", "Stand!"},
+    {"hello", "wave", "Hello!"}, {"wave", "wave", "Wave!"}, {"dance", "dance", "Dance!"},
+    {"walk", "walk", "Walk!"}, {"stop", nullptr, "Stop!"}};
+  const Word* w = nullptr;
+  for (const auto& x : WORDS) if (!strcmp(word, x.word)) w = &x;
+  if (!w) return "ERR VOICE unknown word: " + String(word);
+  alive.showText(w->face, 2000); living = true; benchDisplay = false;
+  if (!w->motion) {
+    if (owner == VOICE || owner == DEMO) { demoEnabled = demoRunning = false; outputsOff("voice stop"); }
+    return "OK VOICE stop";
+  }
+  if (HWCDC::isPlugged()) return "OK VOICE " + String(word) + " (USB plugged: face only, no motion)";
+  if (gate.active() && owner != VOICE && owner != DEMO) return "ERR VOICE robot owned by another transport; off first";
+  const uint32_t now = millis();
+  if (owner == DEMO) { demoEnabled = demoRunning = false; owner = VOICE; logEvent("voice takes over demo"); }
+  if (!gate.active()) {
+    if (!ready || fault || !saved) return "ERR VOICE hub or saved calibration not ready";
+    if (!gate.arm(Mode::Run, -1, now)) return "ERR VOICE arm run failed (verify all joints, save)";
+    owner = VOICE;
+  }
+  voiceLast = now; startMotion(w->motion); gate.heartbeat(now);
+  return "OK VOICE " + String(word) + " -> " + w->motion;
+}
+void voiceService() {
+  if (owner == VOICE && !motion && millis() - voiceLast > 120000) outputsOff("voice idle 2 min");
+}
+void demoService() {
+  // A USB cable to a host (even with no serial port open) means bench, not battery.
+  if (!demoEnabled || HWCDC::isPlugged()) return;
+  const uint32_t now = millis();
+  if (demoRunning && (owner != DEMO || !gate.active())) {
+    demoEnabled = demoRunning = false; Serial.println("DEMO stopped"); return;
+  }
+  if (!demoRunning) {
+    if (now < 5000 || !ready || fault || !saved || gate.active()) return;
+    if (!gate.arm(Mode::Run, -1, now)) { demoEnabled = false; return; }
+    owner = DEMO; demoRunning = true; demoStep = 0; demoNext = now; cancelQueue();
+    logEvent("demo armed"); gate.heartbeat(millis());
+  }
+  gate.heartbeat(now);
+  if (motion) { demoNext = now + 5000; return; }
+  if (now < demoNext) return;
+  startMotion(DEMO_SEQUENCE[demoStep]);
+  logEvent(DEMO_SEQUENCE[demoStep]);
+  gate.heartbeat(millis());  // an NVS write can stall the loop
+  demoStep = (demoStep + 1) % (sizeof(DEMO_SEQUENCE) / sizeof(DEMO_SEQUENCE[0]));
+}
+// Pet reactions (face only): tap = happy, triple tap = love, stroke = love,
+// stroke end = sleepy content, lifted = panic face (stars, X eyes, scream), put down = happy.
+void petService() {
+  if (gate.mode == Mode::ClockMeasure || !living) return;  // keep the bus quiet while timing edges
+  const uint32_t now = millis();
+  for (pet::Event e : {touchPad.poll(now), lift.poll(now)}) switch (e) {
+    case pet::Event::Tap: alive.react(Mood::Happy, 2500); break;
+    case pet::Event::TripleTap: alive.react(Mood::Love, 4000); alive.talk(600); break;
+    case pet::Event::Stroke: alive.react(Mood::Love, 600000); break;
+    case pet::Event::StrokeEnd: alive.react(Mood::Sleepy, 3000); break;
+    case pet::Event::Lifted: alive.panic(true); break;
+    case pet::Event::PutDown: alive.panic(false); alive.react(Mood::Happy, 3000); break;
+    case pet::Event::None: break;
+  }
+}
