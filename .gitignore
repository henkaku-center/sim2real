# Chi local state and sensitive artifacts (runtime state lives under ~/.chi)
.chi/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node
node_modules/
web/dist/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Test artifacts (screenshots etc.)
tests/artifacts/

# Reproducible, checksum-verified upstream CAD downloads (see assets/cad/README.md)
assets/cad/upstream/

# Version native CAD through LFS and the small preview through regular Git.
# Keep automatic backups, full audit output and runtime markers local.
assets/cad/work/*
!assets/cad/work/*.FCStd
!assets/cad/work/sesame-isometric.png
!assets/cad/work/circuitry-preview.png
