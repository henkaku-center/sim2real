{
  "schema": 1,
  "design": "internal-frame-s3",
  "scope": "CAD-derived, not physical. Exact triangle-mesh contact (python-fcl) between the unchanged upstream v117 leg prints and this design's printed body parts, one hip moving at a time with the others at rest; feet on a grid over each hip's contact-free angles. Nominal geometry: no print tolerance, servo or horn play, trim error, cables, screws, servo cases, ground contact or loaded deflection.",
  "not_modelled": [
    "hip and foot servo cases, horns and screws: the design directory has no positioned servo solids",
    "ribbon cables and connectors",
    "two or more joints of different legs moving at once, beyond the neighbour sample",
    "ground contact, loads and dynamics"
  ],
  "definitions": {
    "toward_middle, toward_end": "Swing from rest toward the middle of the body (the print's wide side) or toward the nearer end (the Standing direction), in degrees from rest.",
    "free_servo_deg": "Contact-free servo interval that contains rest.",
    "contact_bands": "Servo intervals in contact with one part. A transient band has free travel on both sides.",
    "max_overlap_mm": "Transient bands: smallest shift of the print along +-X, +-Y or +-Z that clears the contact, at the worst sampled angle. An upper bound of the penetration depth; null if no such shift within settings.overlap_limit_mm clears it.",
    "near_bands_servo_deg": "Servo intervals where the smallest gap is below settings.near_gap_mm, contact included.",
    "gap_profile_mm": "Smallest distance to each reachable part at whole servo degrees 0..180; 0 is contact.",
    "out_of_reach_vertical_gap_mm": "Parts wholly above or below the hip print's fixed height range."
  },
  "coordinates": "X front/OLED, Y left, Z up; PCB USB toward rear",
  "units": "mm, servo degrees",
